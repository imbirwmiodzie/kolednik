{
  "slug": "przybiezeli-do-betlejem",
  "title": "Przybieżeli do Betlejem",
  "art": {
    "motif": "stable",
    "hue": 30
  },
  "bpm": 150,
  "key": "G",
  "stanzas": [
    {
      "type": "verse",
      "lines": [
        {
          "text": "Przybieżeli do Betlejem pasterze,",
          "chords": "G D7 G"
        },
        {
          "text": "Grając skocznie Dzieciąteczku na lirze.",
          "chords": "G D7 G"
        }
      ]
    },
    {
      "type": "chorus",
      "ref": "refren"
    },
    {
      "type": "verse",
      "lines": [
        {
          "text": "Oddawali swe ukłony w pokorze",
          "chords": "G D7 G"
        },
        {
          "text": "Tobie z serca ochotnego, o Boże!",
          "chords": "G D7 G"
        }
      ]
    },
    {
      "type": "chorus",
      "ref": "refren"
    },
    {
      "type": "verse",
      "lines": [
        {
          "text": "Anioł Pański sam ogłosił te dziwy,",
          "chords": "G D7 G"
        },
        {
          "text": "Których oni nie słyszeli, jak żywi.",
          "chords": "G D7 G"
        }
      ]
    },
    {
      "type": "chorus",
      "ref": "refren"
    },
    {
      "type": "verse",
      "lines": [
        {
          "text": "Dziwili się napowietrznej muzyce",
          "chords": "G D7 G"
        },
        {
          "text": "I myśleli, co to będzie za Dziecię?",
          "chords": "G D7 G"
        }
      ]
    },
    {
      "type": "chorus",
      "ref": "refren"
    },
    {
      "type": "verse",
      "lines": [
        {
          "text": "Poznali Go Mesjaszem być prawdziwym,",
          "chords": "G D7 G"
        },
        {
          "text": "Narodzonym dziś Panem miłościwym.",
          "chords": "G D7 G"
        }
      ]
    },
    {
      "type": "chorus",
      "ref": "refren"
    },
    {
      "type": "verse",
      "lines": [
        {
          "text": "I anieli gromadą pilnują,",
          "chords": "G D7 G"
        },
        {
          "text": "Panna czysta wraz z Józefem piastują.",
          "chords": "G D7 G"
        }
      ]
    },
    {
      "type": "chorus",
      "ref": "refren"
    }
  ],
  "choruses": {
    "refren": {
      "lines": [
        {
          "text": "Chwała na wysokości, chwała na wysokości,",
          "chords": "C G D7 G"
        },
        {
          "text": "A pokój na ziemi.",
          "chords": "D7 G"
        }
      ]
    }
  }
}
