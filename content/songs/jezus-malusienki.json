{
  "slug": "jezus-malusienki",
  "title": "Jezus malusieńki",
  "art": {
    "motif": "tree",
    "hue": 140
  },
  "bpm": 110,
  "key": "D",
  "stanzas": [
    {
      "type": "verse",
      "lines": [
        {
          "text": "Jezus malusieńki leży wśród stajenki,",
          "chords": "D A7 D"
        },
        {
          "text": "Płacze z zimna, nie dała Mu Matula sukienki.",
          "chords": "G D A7 D"
        }
      ]
    },
    {
      "type": "verse",
      "lines": [
        {
          "text": "Bo uboga była, rąbek z głowy zdjęła,",
          "chords": "D A7 D"
        },
        {
          "text": "W który Dziecię owinąwszy, siankiem Je okryła.",
          "chords": "G D A7 D"
        }
      ]
    },
    {
      "type": "verse",
      "lines": [
        {
          "text": "Nie ma kolebeczki ani poduszeczki,",
          "chords": "D A7 D"
        },
        {
          "text": "We żłobie Mu położyła siana pod główeczki.",
          "chords": "G D A7 D"
        }
      ]
    }
  ]
}
