{
  "slug": "lulajze-jezuniu",
  "title": "Lulajże, Jezuniu",
  "art": {
    "motif": "moon",
    "hue": 290
  },
  "bpm": 90,
  "key": "G",
  "stanzas": [
    {
      "type": "verse",
      "lines": [
        {
          "text": "Lulajże, Jezuniu, moja perełko,",
          "chords": "G D7"
        },
        {
          "text": "Lulaj, ulubione me pieścidełko.",
          "chords": "D7 G"
        }
      ]
    },
    {
      "type": "chorus",
      "ref": "refren"
    },
    {
      "type": "verse",
      "lines": [
        {
          "text": "Zamknijże znużone płaczem powieczki,",
          "chords": "G D7"
        },
        {
          "text": "Utulże zemdlone łkaniem usteczki.",
          "chords": "D7 G"
        }
      ]
    },
    {
      "type": "chorus",
      "ref": "refren"
    },
    {
      "type": "verse",
      "lines": [
        {
          "text": "Lulajże, piękniuchny nasz aniołeczku,",
          "chords": "G D7"
        },
        {
          "text": "Lulajże, wdzięczniuchny świata kwiateczku.",
          "chords": "D7 G"
        }
      ]
    },
    {
      "type": "chorus",
      "ref": "refren"
    },
    {
      "type": "verse",
      "lines": [
        {
          "text": "Lulajże, różyczko najozdobniejsza,",
          "chords": "G D7"
        },
        {
          "text": "Lulajże, lilijko najprzyjemniejsza.",
          "chords": "D7 G"
        }
      ]
    },
    {
      "type": "chorus",
      "ref": "refren"
    },
    {
      "type": "verse",
      "lines": [
        {
          "text": "Lulajże, przyjemna oczom gwiazdeczko,",
          "chords": "G D7"
        },
        {
          "text": "Lulaj, najśliczniejsze świata słoneczko.",
          "chords": "D7 G"
        }
      ]
    },
    {
      "type": "chorus",
      "ref": "refren"
    }
  ],
  "choruses": {
    "refren": {
      "lines": [
        {
          "text": "Lulajże, Jezuniu, lulajże, lulaj!",
          "chords": "G C"
        },
        {
          "text": "A Ty Go, Matulu, w płaczu utulaj.",
          "chords": "D7 G"
        }
      ]
    }
  }
}
