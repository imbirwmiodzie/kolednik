    "socket.io": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.0"
  }
}
